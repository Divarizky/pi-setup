{
  "name": "pi-setup",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:extensions": "node scripts/check-extensions.mjs",
    "test:git-info": "npm --prefix extensions/git-info test",
    "test:run-summaries": "npm --prefix extensions/run-summaries test",
    "test:subagents": "npm --prefix extensions/subagents test",
    "test:todos": "node --test --experimental-strip-types extensions/todos/reducer.test.ts",
    "test:ui-customization": "node --test --experimental-strip-types extensions/ui-customization/src/*.test.ts",
    "format:check": "prettier --check \"extensions/{copy-all/**/*.{ts,tsx},dashboard-state/**/*.{ts,tsx}}\" \"scripts/*.mjs\" \"*.json\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@effect/platform-node": "^4.0.0-beta.99",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@sinclair/typebox": "^0.34.49",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4",
    "effect": "^4.0.0-beta.102",
    "get-east-asian-width": "^1.6.0",
    "typebox": "^1.3.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.5.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
